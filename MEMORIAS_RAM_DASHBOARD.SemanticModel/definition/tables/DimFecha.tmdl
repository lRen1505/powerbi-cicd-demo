	partition DimFecha = calculated
		mode: import
		source =
				ADDCOLUMNS(
				     CALENDAR(MIN(Importaciones_RAM[Fecha]), MAX(Importaciones_RAM[Fecha])
				     ),
				
				     "Año", YEAR([Date]),
				     "MesNumero", MONTH([Date]),
				     "Mes", FORMAT([Date],"MMMM"),
				     "Trimestre", "T" & FORMAT([Date],"Q")
				)

