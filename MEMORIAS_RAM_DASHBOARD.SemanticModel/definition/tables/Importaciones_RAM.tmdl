	column DIAS_TRANSITO
		dataType: int64
		formatString: 0
		lineageTag: 3a1d59e4-2b42-4583-8414-6cab4347b8c2
		summarizeBy: sum
		sourceColumn: DIAS_TRANSITO

		annotation SummarizationSetBy = Automatic

	partition Importaciones_RAM = m
		mode: import
		source =
				let
				    // CAMBIA ESTA RUTA por la ruta del Excel original en tu computadora.
				    RutaArchivo = "C:\Users\yusuk\Downloads\MemoriasRAM.xlsx",
				    Origen = Excel.Workbook(File.Contents(RutaArchivo), null, true),
				    HojaDatasur = Origen{[Item="Datasur",Kind="Sheet"]}[Data],
				    Encabezados = Table.PromoteHeaders(HojaDatasur, [PromoteAllScalars=true]),
				
				    // Eliminar solo las columnas que ya habías descartado.
				    ColumnasEliminadas = Table.RemoveColumns(Encabezados,
				        {"DIRECCIÓN", "TELÉFONO", "FAX", "AÑO FABRICACIÓN", "ADVALOREM", "BILL OF LADING MASTER", "BILL OF LADING"},
				        MissingField.Ignore),
				
				    // Convertir primero las partes de la fecha. Los errores se convierten en null para revisión.
				    PartesFecha = Table.TransformColumns(ColumnasEliminadas,
				        {{"DÍA", each try Int64.From(_) otherwise null, Int64.Type},
				         {"MES", each try Int64.From(_) otherwise null, Int64.Type},
				         {"AÑO", each try Int64.From(_) otherwise null, Int64.Type}}),
				    FechaAgregada = Table.AddColumn(PartesFecha, "Fecha",
				        each try #date([AÑO],[MES],[DÍA]) otherwise null, type date),
				    FechaUnificada = Table.RemoveColumns(FechaAgregada,{"DÍA","MES","AÑO"}),
				
				    // Tipos solo para columnas que realmente existan.
				    ColumnasTexto = {"DUA","SERIE","ADUANA","TIPO DOCUMENTO","RUC IMPORTADOR", "IMPORTADOR",
				        "DEPARTAMENTO DE IMPORTADOR", "PROVINCIA", "DISTRITO", "VÍA DE TRANSPORTE", "BANCO",
				        "PAÍS DE ORIGEN", "PAÍS DE ADQUISICIÓN", "PUERTO DE EMBARQUE", "PARTIDA ARANCELARIA",
				        "DESCRIPCIÓN ARANCELARIA", "MERCANCÍA", "DESCRIPCIÓN DE MERCANCÍA 1",
				        "DESCRIPCIÓN DE MERCANCÍA 2", "DESCRIPCIÓN DE MERCANCÍA 3", "DESCRIPCIÓN DE MERCANCÍA 4",
				        "PRODUCTO", "MARCA", "MODELO", "CARACTERÍSTICAS", "UNIDAD DE MEDIDA", "UNIDAD COMERCIAL",
				        "TIPO DE BULTO", "ESTADO DE MERCANCIA", "PROBABLE EMBARCADOR", "AGENTE DE ADUANA",
				        "EMPRESA DE TRANSPORTE", "ALMACEN", "INCOTERM", "MANIFIESTO DE CARGA", "BUQUE",
				        "AGENTE DE CARGA EN DESTINO", "FORMA DE PAGO", "CANAL"},
				    ColumnasDecimales = {"US$ FOB", "US$ FLETE", "US$ SEGURO", "US$ CIF", "IGV", "IPM",
				        "PESO NETO", "PESO BRUTO", "US$ CIF UNIT", "US$ FOB UNIT"},
				    ColumnasEnteras = {"CANTIDAD", "CANTIDAD COMERCIAL", "CANTIDAD BULTO"},
				    TextoTipado = Table.TransformColumns(FechaUnificada,
				        List.Transform(List.Intersect({ColumnasTexto,Table.ColumnNames(FechaUnificada)}),
				            (n) => {n, (v) => if v = null then null else Text.From(v), type text})),
				    NumerosTipados = Table.TransformColumns(TextoTipado,
				        List.Transform(List.Intersect({ColumnasDecimales,Table.ColumnNames(TextoTipado)}),
				            (n) => {n,(v) => try Number.From(v,"en-US") otherwise null, type number})),
				    CantidadesTipadas = Table.TransformColumns(NumerosTipados,
				        List.Transform(List.Intersect({ColumnasEnteras,Table.ColumnNames(NumerosTipados)}),
				            (n) => {n,(v) => try Int64.From(v) otherwise null, Int64.Type})),
				
				    // Recortar, limpiar y convertir texto vacío a null.
				    TextosLimpios = Table.TransformColumns(CantidadesTipadas,
				        List.Transform(List.Intersect({ColumnasTexto,Table.ColumnNames(CantidadesTipadas)}),
				            (n) => {n,(v) => if v = null then null else
				                let t=Text.Trim(Text.Clean(v)) in if t = "" then null else t, type text})),
				
				    // Unificar nombres de marca sin reemplazos parciales dentro de otras palabras.
				    MarcaEstandar = Table.TransformColumns(TextosLimpios,
				        {{"MARCA", (v) => if v = null then "NO ESPECIFICADA" else
				            let m=Text.Upper(v) in
				                if m = "KINSGTON" or m = "KINGSTON" then "KINGSTON"
				                else if m = "S/M" or m = "S-M" or m = "N/A" then "NO ESPECIFICADA"
				                else m, type text}}),
				    ModeloEstandar = Table.TransformColumns(MarcaEstandar,
				        {{"MODELO", (v) => if v = null then "NO ESPECIFICADO"
				            else if List.Contains({"S/M","S-M","N/A"},Text.Upper(v)) then "NO ESPECIFICADO"
				            else v, type text}}),
				
				    // Productos sin descripción quedan nulos; no se inventan productos ni se quitan filas.
				    // Conservamos todas las operaciones: no se eliminan registros solo por valores vacíos.
				    Resultado = ModeloEstandar,
				    #"Valor reemplazado" = Table.ReplaceValue(Resultado,"COREA {SUR}","COREA DEL SUR",Replacer.ReplaceText,{"PAÍS DE ORIGEN"}),
				    #"Valor reemplazado1" = Table.ReplaceValue(#"Valor reemplazado","TAIWAN {FORMOSA}","TAIWAN",Replacer.ReplaceText,{"PAÍS DE ORIGEN"}),
				    #"Valor reemplazado2" = Table.ReplaceValue(#"Valor reemplazado1","HONG KONG {CHINA}","HONG KONG",Replacer.ReplaceText,{"PAÍS DE ADQUISICIÓN"}),
				    #"Valor reemplazado3" = Table.ReplaceValue(#"Valor reemplazado2","COREA {SUR}","COREA DEL SUR",Replacer.ReplaceText,{"PAÍS DE ADQUISICIÓN"}),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Valor reemplazado3",{{"FECHA DE EMBARQUE", type date}, {"FECHA DE LLEGADA", type date}}),
				    #"Personalizada agregada" = Table.AddColumn(#"Tipo cambiado", "DIAS_TRANSITO", each if [FECHA DE EMBARQUE] = null or [FECHA DE LLEGADA] = null
				then null
				else Duration.Days(
				    [FECHA DE LLEGADA] - [FECHA DE EMBARQUE]
				)),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Personalizada agregada",{{"DIAS_TRANSITO", Int64.Type}}),
				    #"Errores reemplazados" = Table.ReplaceErrorValues(#"Tipo cambiado1", {{"FECHA DE LLEGADA", null}}),
				    #"Errores reemplazados1" = Table.ReplaceErrorValues(#"Errores reemplazados", {{"DIAS_TRANSITO", null}})
				in
				    #"Errores reemplazados1"

	changedProperty = Name

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

